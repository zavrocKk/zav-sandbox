{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GSANE Delivery Contract Schema",
  "type": "object",
  "required": ["id", "task", "files", "constraints", "acceptance_criteria", "agent_principal", "validation_agent"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Identifiant unique du DC (ex: P6-A, DC-TOKEN-OPTIM)"
    },
    "task": {
      "type": "string",
      "description": "Description de la tâche"
    },
    "files": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "description": "Fichiers impactés"
    },
    "constraints": {
      "type": "string",
      "description": "Contraintes architecturales"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AC-\\d+\\s*:"
      },
      "minItems": 1,
      "description": "Critères d'acceptance au format AC-N: action + résultat mesurable"
    },
    "agent_principal": {
      "type": "string",
      "description": "Agent qui implémente"
    },
    "validation_agent": {
      "type": "string",
      "description": "Agent qui valide"
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ac_id": {"type": "string"},
          "level": {"type": "string", "enum": ["unit", "integration", "e2e"]},
          "condition": {"type": "string"},
          "expected": {"type": "string"},
          "counter_example": {"type": "string"},
          "test_name": {"type": "string"},
          "risk_if_false": {"type": "string"}
        },
        "required": ["ac_id", "level", "condition", "expected"]
      },
      "description": "Hypothèses testables par AC (optionnel)"
    }
  }
}
