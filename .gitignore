# gsane Sandbox — .gitignore

# Workspace artifacts
instructions.md

# Large generated outputs (commit only intentionally)

# Sortie GSANE
_gsane-output/*
!_gsane-output/bond-creations/.gitkeep
!_gsane-output/test-artifacts/.gitkeep

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OS artifacts
.DS_Store
Thumbs.db

# Editor

# Ne versionner que .vscode/extensions.json
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# VS Code workspace file (chemins locaux, ne pas commiter)
*.code-workspace

# GSANE Stateless sessions
_gsane/_memory/sessions/*.md
_gsane/_memory/sessions/*.yaml

# MCP Configuration


github-copilot.mcp.json

# GSANE — Fichiers volatiles (générés à runtime, ne pas committer)
# _gsane/_memory/trace.log is tracked with a seed entry for CI
_gsane/_memory/sessions/session-state.md
_gsane/_memory/.session_count
_gsane-output/delegation-audit.md
_gsane-output/violations.log
_gsane-output/party-mode-audit.md
_gsane-output/cc-verify-*.log
.coverage
