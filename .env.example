# zav-sandbox — gabarit de configuration des jetons (copier vers .env)
#
#   cp .env.example .env        # .env est git-ignoré (voir .gitignore)
#
# Hygiène des jetons :
# - JAMAIS de valeur réelle dans ce fichier — il est versionné.
# - Portée minimale (lecture seule si possible), rotation régulière.
# - Les valeurs réelles viennent du coffre de l'entreprise, pas d'un partage chat/mail.
# - Le scanner de secrets (agents/hooks/secrets-scanner) reste actif en fin de session.
#
# NOTE PROJET : aucune intégration ne consomme encore ces variables (exclusion
# active — MCP évalué plus tard par ADR, au travail). Ce fichier prépare le
# terrain : noms stables, place réservée, hygiène posée.

# ── JIRA (Atlassian) ─────────────────────────────────────────────
# Cloud : email + API token (id.atlassian.com → Security → API tokens)
# Server/DC : utiliser un PAT dans JIRA_API_TOKEN et laisser JIRA_EMAIL vide
JIRA_BASE_URL=https://<org>.atlassian.net
JIRA_EMAIL=<prenom.nom@entreprise.com>
JIRA_API_TOKEN=<REDACTED>

# ── Confluence (Atlassian) ───────────────────────────────────────
# Cloud : le même API token Atlassian fonctionne généralement pour les deux
CONFLUENCE_BASE_URL=https://<org>.atlassian.net/wiki
CONFLUENCE_EMAIL=<prenom.nom@entreprise.com>
CONFLUENCE_API_TOKEN=<REDACTED>

# ── Control-M (BMC — Automation API) ─────────────────────────────
# Endpoint type : https://<host>:8443/automation-api
CONTROLM_AAPI_ENDPOINT=https://<host>:8443/automation-api
CONTROLM_API_TOKEN=<REDACTED>
